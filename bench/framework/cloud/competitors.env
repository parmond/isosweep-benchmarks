# Competitor build pins (sourced by setup_ubuntu.sh). The competitor bundle
# (GDAL builds, workers, the exact pip lock) is reused byte for byte while these
# and the competitor worker sources are unchanged (isobench/store.py
# competitor_build_key): their results are then reused too (R13).
RUST_TOOLCHAIN=1.98.1
GDAL_STABLE_REF=v3.13.3
GDAL_MASTER_COMMIT="${GDAL_MASTER_COMMIT:-fedfd3ec89d6674de030db8f351233f2ee164c30}"
PIP_PINS="numpy==2.4.4 scipy==1.17.1 contourpy==1.4.0 matplotlib==3.10.9 scikit-image==0.26.0 vtk==9.6.2 PyMCubes==0.1.6 PyYAML==6.0.3 Cython"
